# Copy to .env.local for local dev (gitignored). On Vercel, set these under
# Project Settings -> Environment Variables instead.
AUTH_USER=admin
AUTH_PASSWORD=change-me

# SeatControl backend integration (leave unset to keep using the local mock data)
SEATCONTROL_API_BASE_URL=
SEATCONTROL_ORG_ID=
SEATCONTROL_API_EMAIL=
SEATCONTROL_API_PASSWORD=

# Direct device ingest (takes priority over the backend and the mock data).
# BLOB_READ_WRITE_TOKEN is added automatically when you connect a PRIVATE Vercel
# Blob store to the project. INGEST_TOKEN is a shared secret the Android app
# sends as "Authorization: Bearer <token>" (same value as its VIDEO_MAP_INGEST_TOKEN).
BLOB_READ_WRITE_TOKEN=
INGEST_TOKEN=
